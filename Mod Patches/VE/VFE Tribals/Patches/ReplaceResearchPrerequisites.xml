            <xpath>Defs/*/researchPrerequisites/li[text()="RR_BasicRangedWeapons"]</xpath>
            <value>
                <li>VFET_Bow</li>
            </value>
        </match>
    </Operation>

    <Operation Class="PatchOperationConditional">
        <xpath>Defs/*/researchPrerequisites/li[text()="RR_BasicHerbLore"]</xpath>
        <match Class="PatchOperationReplace">
            <xpath>Defs/*/researchPrerequisites/li[text()="RR_BasicHerbLore"]</xpath>
            <value>
