<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <!-- RR:SS does this on its own, but we're doing it again here in case we need to update anything that loaded between RR:SS and this mod -->
    <Operation Class="PatchOperationConditional">
        <xpath>Defs/*/researchPrerequisites/li[text()="RR_Fire"]</xpath>
        <match Class="PatchOperationReplace">
            <xpath>Defs/*/researchPrerequisites/li[text()="RR_Fire"]</xpath>
            <value>
                <li>VFET_Fire</li>
            </value>
        </match>
    </Operation>

    <Operation Class="PatchOperationConditional">
        <xpath>Defs/*/researchPrerequisites/li[text()="RR_Agriculture"]</xpath>
        <match Class="PatchOperationReplace">
            <xpath>Defs/*/researchPrerequisites/li[text()="RR_Agriculture"]</xpath>
            <value>
                <li>VFET_Cultivation</li>
            </value>
        </match>
    </Operation>

    <Operation Class="PatchOperationConditional">
