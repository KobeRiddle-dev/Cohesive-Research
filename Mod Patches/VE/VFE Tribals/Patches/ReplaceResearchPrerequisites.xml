        <match Class="PatchOperationReplace">
            <xpath>Defs/*/researchPrerequisites/li[text()="RR_BasicFurniture"]</xpath>
            <value>
                <li>VFET_Furniture</li>
            </value>
        </match>
    </Operation>

    <Operation Class="PatchOperationConditional">
        <xpath>Defs/*/researchPrerequisites/li[text()="RR_BasicStructures"]</xpath>
        <match Class="PatchOperationReplace">
            <xpath>Defs/*/researchPrerequisites/li[text()="RR_BasicStructures"]</xpath>
            <value>
                <li>VFET_Construction</li>
            </value>
        </match>
    </Operation>

    <Operation Class="PatchOperationConditional">
        <xpath>Defs/*/researchPrerequisites/li[text()="RR_Trapping"]</xpath>
        <match Class="PatchOperationReplace">
            <xpath>Defs/*/researchPrerequisites/li[text()="RR_Trapping"]</xpath>
            <value>
                <li>VFET_Hunting</li>
            </value>
        </match>
    </Operation>
</Patch>